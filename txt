                        if (newPass === null) return;
                        if (newPass.trim().length > 12) {
                            alert("板のパスワードは最大12文字までです。");
                            return;
                        }
                        await update(ref(db, `board_meta/${bId}`), { password: newPass.trim() });
                        showToast("板のパスワードを更新しました");
