<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>■ 管理者コントロールパネル ■</title>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #F8F9FA;
            font-family: "DotGothic16", "MS PGothic", monospace;
            color: #000000;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade {
            animation: fadeIn 0.2s ease-out forwards;
        }
        /* ポリゴンショック（動的スピード対応） */
        @keyframes polygonShockEffect {
            0% { background-color: var(--shock-color-1, #ff0000) !important; filter: invert(1); }
            50% { background-color: var(--shock-color-2, #0000ff) !important; filter: invert(0); }
            100% { background-color: var(--shock-color-1, #ff0000) !important; filter: invert(1); }
        }
        .polygon-shock-active {
            animation: polygonShockEffect var(--shock-speed, 0.08s) infinite !important;
        }

        /* 画面を揺らすエフェクト */
        @keyframes screenShakeEffect {
            0% { transform: translate(0, 0); }
            20% { transform: translate(var(--shake-range-x1, -5px), var(--shake-range-y1, 5px)); }
            40% { transform: translate(var(--shake-range-x2, 5px), var(--shake-range-y2, -5px)); }
            60% { transform: translate(var(--shake-range-x1, -5px), var(--shake-range-y2, -5px)); }
            80% { transform: translate(var(--shake-range-x2, 5px), var(--shake-range-y1, 5px)); }
            100% { transform: translate(0, 0); }
        }
        .screen-shake-active {
            animation: screenShakeEffect var(--shake-speed, 0.05s) infinite !important;
        }
    </style>
</head>
<body class="p-2 md:p-4 flex items-center justify-center min-h-screen relative text-black">

    <!-- 右上 通知トースト -->
    <div id="toast-container" class="fixed top-4 right-4 z-[10000] flex flex-col gap-2 pointer-events-none max-w-[calc(100vw-2rem)]"></div>

    <!-- 管理者用モーダル（常時表示） -->
    <div id="admin-modal" class="fixed inset-0 bg-black/40 flex items-center justify-center p-2 md:p-4 z-50 overflow-y-auto">
        <div class="bg-white border-2 border-black max-w-3xl w-full p-3 md:p-4 shadow-lg max-h-[92vh] flex flex-col text-xs my-auto text-black">
            
            <!-- ヘッダー -->
            <div class="flex justify-between items-center border-b-2 border-black pb-2 mb-3 shrink-0">
                <h2 class="text-xs md:text-sm font-bold text-black truncate pr-2">■ 管理者コントロールパネル ■</h2>
                <div class="text-[10px] md:text-xs text-black font-bold whitespace-nowrap">管理者専用</div>
            </div>

            <!-- タブ -->
            <div class="flex border-b border-black mb-3 text-xs font-bold shrink-0">
                <button id="admin-tab-users-btn" class="flex-1 py-1.5 px-1 text-center bg-white border-t border-l border-r border-black text-black cursor-pointer truncate text-[10px] md:text-xs">
                    アカウント管理
                </button>
                <button id="admin-tab-create-btn" class="flex-1 py-1.5 px-1 text-center bg-gray-100 border border-black border-b-0 text-black cursor-pointer truncate text-[10px] md:text-xs">
                    作成
                </button>
                <button id="admin-tab-threads-btn" class="flex-1 py-1.5 px-1 text-center bg-gray-100 border border-black border-b-0 text-black cursor-pointer truncate text-[10px] md:text-xs">
                    チャット管理
                </button>
                <button id="admin-tab-boards-btn" class="flex-1 py-1.5 px-1 text-center bg-gray-100 border border-black border-b-0 text-black cursor-pointer truncate text-[10px] md:text-xs">
                    板管理
                </button>
                <button id="admin-tab-extra-btn" class="flex-1 py-1.5 px-1 text-center bg-gray-100 border border-black border-b-0 text-black cursor-pointer truncate text-[10px] md:text-xs">
                    ???
                </button>
            </div>

            <!-- スクロール可能なコンテンツエリア -->
            <div class="overflow-y-auto flex-1 pr-0.5">

                <!-- 1. アカウント管理 -->
                <div id="admin-section-users" class="space-y-2.5">
                    <div id="account-count-display" class="font-bold text-black text-xs bg-gray-100 p-2 border border-black"></div>
                    
                    <!-- リストタイトル ＋ ハンバーガーメニュー -->
                    <div class="flex justify-between items-center relative">
                        <div id="account-list-title" class="font-bold text-black">【登録アカウント一覧 (1秒毎にリロード)】</div>
                        
                        <!-- ハンバーガーボタン -->
                        <div class="relative">
                            <button type="button" id="hamburger-menu-btn" class="px-2.5 py-1 bg-gray-100 border border-black font-bold text-black text-xs cursor-pointer hover:bg-gray-200">
                                ☰ 
                            </button>
                            <!-- ハンバーガーメニューの中身 -->
                            <div id="hamburger-dropdown-menu" class="hidden absolute right-0 top-full mt-1 bg-white border border-black shadow-lg z-50 w-48 font-bold text-xs">
                                <button type="button" id="menu-filter-normal" class="w-full text-left px-3 py-2 hover:bg-gray-100 border-b border-black cursor-pointer">登録アカウント一覧</button>
                                <button type="button" id="menu-filter-ban" class="w-full text-left px-3 py-2 hover:bg-gray-100 border-b border-black cursor-pointer">BAN中アカウント一覧</button>
                                <button type="button" id="menu-filter-timeout" class="w-full text-left px-3 py-2 hover:bg-gray-100 cursor-pointer">タイムアウト中一覧</button>
                            </div>
                        </div>
                    </div>

                    <div id="admin-users-container" class="space-y-1.5 border border-black p-2.5 bg-gray-50 max-h-56 overflow-y-auto">
                        <div class="text-black text-xs font-bold">読み込み中...</div>
                    </div>
                </div>

                <!-- 2. アカウント作成 -->
                <div id="admin-section-create" class="space-y-2.5 hidden">
                    <div class="font-bold text-black">【新規アカウント作成 (最大65個)】</div>
                    <div>
                        <label class="block font-bold text-black mb-1">お名前（ニックネーム）:</label>
                        <input type="text" id="admin-reg-name" placeholder="例：山田" class="w-full border border-black px-2.5 py-1.5 bg-white text-black font-bold">
                    </div>
                    <div>
                        <label class="block font-bold text-black mb-1">肩書き / 二つ名 (選択):</label>
                        <div class="relative" id="custom-dropdown-container">
                            <button type="button" id="custom-dropdown-toggle" class="w-full border border-black px-2.5 py-1.5 bg-white text-black font-bold flex justify-between items-center cursor-pointer text-left">
                                <span id="custom-dropdown-selected-label" class="truncate font-bold">（なし）</span>
                                <span class="text-[10px] text-black font-bold ml-2 shrink-0">▼</span>
                            </button>
                            <div id="custom-dropdown-menu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-black shadow-lg max-h-48 overflow-y-auto z-50"></div>
                        </div>
                        <input type="hidden" id="admin-reg-title" value="">
                    </div>
                    <div>
                        <label class="block font-bold text-black mb-1">ID（重複不可）:</label>
                        <input type="text" id="admin-reg-id" placeholder="半角英数字ID" class="w-full border border-black px-2.5 py-1.5 bg-white text-black font-bold">
                    </div>
                    <div>
                        <label class="block font-bold text-black mb-1">パスワード:</label>
                        <div class="flex gap-2">
                            <input type="password" id="admin-reg-pass" placeholder="パスワード" class="w-full border border-black px-2.5 py-1.5 bg-white text-black font-bold">
                            <button type="button" id="toggle-password-visibility" class="px-3 py-1 bg-gray-200 border border-black font-bold text-black text-xs cursor-pointer hover:bg-gray-300 shrink-0 flex items-center justify-center w-10">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                            </button>
                        </div>
                    </div>
                    <button id="admin-do-create-btn" class="w-full bg-gray-200 border border-black py-1.5 text-xs font-bold text-black hover:bg-gray-300 cursor-pointer shadow-sm">
                        アカウントを作成する
                    </button>
                </div>

                <!-- 3. チャット管理 -->
                <div id="admin-section-threads" class="space-y-2.5 hidden">
                    <div class="font-bold text-black">【スレッド削除管理】</div>
                    <div>
                        <label class="block font-bold text-black mb-1">管理する板を選択 (1秒毎にリロード):</label>
                        <div class="relative" id="custom-board-dropdown-container">
                            <button type="button" id="custom-board-dropdown-toggle" class="border border-black px-2 py-1.5 bg-white font-bold text-black w-full flex justify-between items-center cursor-pointer text-left">
                                <span id="custom-board-dropdown-selected-label" class="truncate font-bold">読み込み中...</span>
                                <span class="text-[10px] text-black font-bold ml-2 shrink-0">▼</span>
                            </button>
                            <div id="custom-board-dropdown-menu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-black shadow-lg max-h-48 overflow-y-auto z-50"></div>
                        </div>
                        <input type="hidden" id="admin-board-select" value="">
                    </div>
                    <div id="admin-threads-container" class="space-y-1.5 border border-black p-2.5 bg-gray-50 max-h-56 overflow-y-auto">
                        <div class="text-black text-xs font-bold">スレッド読み込み中...</div>
                    </div>
                </div>

                <!-- 4. 板管理 -->
                <div id="admin-section-boards" class="space-y-2.5 hidden">
                    <div class="font-bold text-black">【板の追加・削除】</div>
                    <div class="bg-gray-50 border border-black p-2.5 space-y-2">
                        <div class="font-bold text-xs text-black">■ 新しい板を作成</div>
                        <div>
                            <label class="block font-bold text-[11px] text-black mb-0.5">板ID (半角英数字・例: game):</label>
                            <input type="text" id="new-board-id-input" placeholder="game" class="w-full border border-black px-2 py-1 text-xs bg-white text-black font-bold">
                        </div>
                        <div>
                            <label class="block font-bold text-[11px] text-black mb-0.5">板のタイトル名 (例: ゲーム板):</label>
                            <input type="text" id="new-board-name-input" placeholder="ゲーム板" class="w-full border border-black px-2 py-1 text-xs bg-white text-black font-bold">
                        </div>
                        <div>
                            <label class="block font-bold text-[11px] text-black mb-0.5">板のパスワード (任意・最大12文字):</label>
                            <div class="flex gap-2">
                                <input type="password" id="new-board-pass-input" placeholder="最大12文字" maxlength="12" class="w-full border border-black px-2 py-1 text-xs bg-white text-black font-bold">
                                <button type="button" id="toggle-board-password-visibility" class="px-3 py-1 bg-gray-200 border border-black font-bold text-black text-xs cursor-pointer hover:bg-gray-300 shrink-0 flex items-center justify-center w-10">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                                </button>
                            </div>
                        </div>
                        <button id="create-board-btn" class="w-full bg-gray-200 border border-black py-1 text-xs font-bold text-black hover:bg-gray-300 cursor-pointer shadow-sm">
                            板を追加する
                        </button>
                    </div>
                    <div class="font-bold text-black mt-3">【既存の板一覧 (パスワード変更・確認可)】</div>
                    <div id="admin-boards-container" class="space-y-1.5 border border-black p-2.5 bg-gray-50 max-h-36 overflow-y-auto">
                        <div class="text-black text-xs font-bold">読み込み中...</div>
                    </div>
                </div>

                <!-- 5. ？？？ -->
                <div id="admin-section-extra" class="space-y-3 hidden">
                    <div class="font-bold text-black">【??? タブ】</div>
                    
                    <!-- ポリゴンショック機能 -->
                    <div class="bg-gray-50 border border-black p-3 space-y-2">
                        <div class="font-bold text-xs text-black flex justify-between items-center">
                            <span>■ ポリゴンショック</span>
                            <div class="flex items-center gap-1.5">
                                <span id="polygon-shock-speed-badge" class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 border border-red-300">速度: 0.08秒</span>
                            </div>
                        </div>
                        <p class="text-[11px] text-gray-700 font-bold leading-relaxed">
                            画面全体が赤と青に猛烈なスピードで点滅する特殊効果を発動します。最高速は0.0001秒です。
                        </p>
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 pt-1">
                            <div class="flex items-center gap-2">
                                <span id="polygon-shock-status-label" class="font-bold text-xs text-black whitespace-nowrap">状態: 停止中</span>
                                <button id="polygon-shock-toggle-btn" class="px-3 py-1.5 bg-gray-200 border border-black font-bold text-black text-xs cursor-pointer hover:bg-gray-300 shadow-sm shrink-0">
                                    発動する
                                </button>
                            </div>

                            <div class="flex items-center gap-1 flex-1 max-w-xs">
                                <div class="relative flex-1" id="shock-users-dropdown-container">
                                    <button type="button" id="shock-users-toggle" class="w-full border border-black px-2 py-1.5 bg-white text-black font-bold flex justify-between items-center cursor-pointer text-left text-xs">
                                        <span id="shock-users-selected-label" class="truncate font-bold">対象を選択 (∞)</span>
                                        <span class="text-[10px] text-black font-bold ml-1 shrink-0">▼</span>
                                    </button>
                                    <div id="shock-users-menu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-black shadow-lg max-h-48 overflow-y-auto z-50"></div>
                                </div>

                                <div class="relative">
                                    <button type="button" id="shock-hamburger-btn" class="px-2.5 py-1.5 bg-white border border-black font-bold text-black text-xs cursor-pointer hover:bg-gray-100 shrink-0">
                                        ☰
                                    </button>
                                    <div id="shock-hamburger-menu" class="hidden absolute right-0 top-full mt-1 bg-white border border-black shadow-lg z-50 w-56 font-bold text-xs">
                                        <button type="button" id="shock-menu-color-1" class="w-full text-left px-3 py-2 hover:bg-gray-100 border-b border-black cursor-pointer flex items-center justify-between">
                                            <span>1・色を変える</span>
                                            <span id="menu-color-chip-1" class="w-3.5 h-3.5 border border-black inline-block shrink-0" style="background-color: #ff0000;"></span>
                                        </button>
                                        <button type="button" id="shock-menu-color-2" class="w-full text-left px-3 py-2 hover:bg-gray-100 border-b border-black cursor-pointer flex items-center justify-between">
                                            <span>2・色を変える</span>
                                            <span id="menu-color-chip-2" class="w-3.5 h-3.5 border border-black inline-block shrink-0" style="background-color: #0000ff;"></span>
                                        </button>
                                        <button type="button" id="shock-menu-speed" class="w-full text-left px-3 py-2 hover:bg-gray-100 cursor-pointer">3・点滅速度を変える</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="shock-selected-users-tags" class="flex flex-wrap gap-1 pt-1"></div>
                    </div>

                    <!-- 画面を揺らす機能 -->
                    <div class="bg-gray-50 border border-black p-3 space-y-2">
                        <div class="font-bold text-xs text-black flex justify-between items-center">
                            <span>■ 画面を揺らす</span>
                            <div class="flex items-center gap-1.5">
                                <span id="screen-shake-speed-badge" class="text-[10px] bg-blue-100 text-blue-700 px-1.5 py-0.5 border border-blue-300">速度: 0.05秒 / 範囲: 5px</span>
                            </div>
                        </div>
                        <p class="text-[11px] text-gray-700 font-bold leading-relaxed">
                            画面全体が激しく揺れ動く特殊効果を発動します。
                        </p>
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2 pt-1">
                            <div class="flex items-center gap-2">
                                <span id="screen-shake-status-label" class="font-bold text-xs text-black whitespace-nowrap">状態: 停止中</span>
                                <button id="screen-shake-toggle-btn" class="px-3 py-1.5 bg-gray-200 border border-black font-bold text-black text-xs cursor-pointer hover:bg-gray-300 shadow-sm shrink-0">
                                    発動する
                                </button>
                            </div>

                            <div class="flex items-center gap-1 flex-1 max-w-xs">
                                <div class="relative flex-1" id="shake-users-dropdown-container">
                                    <button type="button" id="shake-users-toggle" class="w-full border border-black px-2 py-1.5 bg-white text-black font-bold flex justify-between items-center cursor-pointer text-left text-xs">
                                        <span id="shake-users-selected-label" class="truncate font-bold">対象を選択 (∞)</span>
                                        <span class="text-[10px] text-black font-bold ml-1 shrink-0">▼</span>
                                    </button>
                                    <div id="shake-users-menu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-black shadow-lg max-h-48 overflow-y-auto z-50"></div>
                                </div>

                                <div class="relative">
                                    <button type="button" id="shake-hamburger-btn" class="px-2.5 py-1.5 bg-white border border-black font-bold text-black text-xs cursor-pointer hover:bg-gray-100 shrink-0">
                                        ☰
                                    </button>
                                    <div id="shake-hamburger-menu" class="hidden absolute right-0 top-full mt-1 bg-white border border-black shadow-lg z-50 w-52 font-bold text-xs">
                                        <button type="button" id="shake-menu-speed" class="w-full text-left px-3 py-2 hover:bg-gray-100 border-b border-black cursor-pointer">1・揺れる速度を変える</button>
                                        <button type="button" id="shake-menu-range" class="w-full text-left px-3 py-2 hover:bg-gray-100 cursor-pointer">2・揺れる範囲を変える</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="shake-selected-users-tags" class="flex flex-wrap gap-1 pt-1"></div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- 色選択用 カスタムモーダル（ドロップダウン式） -->
    <div id="custom-color-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-[9999]">
        <div class="bg-white border-2 border-black max-w-xs w-full p-3 shadow-xl flex flex-col text-xs space-y-2 text-black font-bold">
            <div id="custom-color-modal-title" class="font-bold text-black border-b border-black pb-1">色を選択</div>
            <div id="custom-color-modal-list" class="max-h-60 overflow-y-auto space-y-1 border border-black p-1.5 bg-gray-50"></div>
            <button id="custom-color-modal-close" class="w-full bg-gray-200 border border-black py-1 font-bold text-black hover:bg-gray-300 cursor-pointer">キャンセル</button>
        </div>
    </div>

    <!-- 肩書き変更用 カスタムモーダル -->
    <div id="custom-title-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-[9999]">
        <div class="bg-white border-2 border-black max-w-xs w-full p-3 shadow-xl flex flex-col text-xs space-y-2 text-black font-bold">
            <div class="font-bold text-black border-b border-black pb-1">肩書きを選択</div>
            <div id="custom-title-modal-list" class="max-h-60 overflow-y-auto space-y-1 border border-black p-1.5 bg-gray-50"></div>
            <button id="custom-title-modal-close" class="w-full bg-gray-200 border border-black py-1 font-bold text-black hover:bg-gray-300 cursor-pointer">キャンセル</button>
        </div>
    </div>

    <!-- タイムアウト設定用 カスタムモーダル -->
    <div id="custom-timeout-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-[9999]">
        <div class="bg-white border-2 border-black max-w-xs w-full p-3 shadow-xl flex flex-col text-xs space-y-2.5 text-black font-bold">
            <div class="font-bold text-black border-b border-black pb-1">タイムアウト設定</div>
            <div>
                <label class="block text-black mb-1">数値を入力:</label>
                <input type="number" id="timeout-input-val" value="30" min="1" class="w-full border border-black px-2.5 py-1.5 bg-white text-black font-bold">
            </div>
            <div>
                <label class="block text-black mb-1">単位を選択:</label>
                <div class="relative" id="timeout-unit-dropdown-container">
                    <button type="button" id="timeout-unit-toggle" class="w-full border border-black px-2.5 py-1.5 bg-white text-black font-bold flex justify-between items-center cursor-pointer text-left">
                        <span id="timeout-unit-label" class="truncate font-bold">分</span>
                        <span class="text-[10px] text-black font-bold ml-2 shrink-0">▼</span>
                    </button>
                    <div id="timeout-unit-menu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-black shadow-lg z-50">
                        <div class="timeout-unit-option px-2.5 py-1.5 cursor-pointer hover:bg-gray-200" data-unit="1">分</div>
