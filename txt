                    div.querySelector('.del-board-btn').addEventListener('click', async () => {
                        if (confirm(`板「${bName} (ID: ${bId})」を削除しますか？`)) {
                            await remove(ref(db, `board_meta/${bId}`));
                            await remove(ref(db, `boards/${bId}`));
                            showToast("板を削除しました");
                            loadBoardSelectOptions();
                            loadAdminBoards();
                        }
                    });
                    adminBoardsContainer.appendChild(div);
                });
            } catch (e) {
                adminBoardsContainer.innerHTML = '<div class="text-black text-xs font-bold">読み込みエラー</div>';
            }
        }
        loadAdminBoards();

    </script>
</body>
</html>
