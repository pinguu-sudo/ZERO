        async function loadAdminUsers() {
            try {
                const snap = await get(ref(db, 'id_registry'));
                let users = {};
                let dbCount = 0;
                if (snap.exists()) {
                    users = snap.val();
                    dbCount = Object.keys(users).length;
                }
                accountCountDisplay.textContent = `現在のアカウント数: ${dbCount} / 65個`;

                const fragment = document.createDocumentFragment();
                const now = Date.now();
                let filteredCount = 0;

                Object.keys(users).forEach(id => {
                    const u = users[id];
                    const isBanned = u.banned ? true : false;
                    const timeoutUntil = u.timeoutUntil || 0;
                    const isTimedOut = timeoutUntil > now;

                    if (currentAccountViewMode === 'ban' && !isBanned) return;
                    if (currentAccountViewMode === 'timeout' && !isTimedOut) return;
                    if (currentAccountViewMode === 'normal' && (isBanned || isTimedOut)) return;

                    filteredCount++;
                    const isAdminUser = (id === '3310');
                    const idDisp = formatDisplayId(id, u.customTitle);
                    
                    let statusLabel = '';
                    if (isBanned) statusLabel += '[BAN中] ';
                    if (isTimedOut) {
                        const remainSec = Math.ceil((timeoutUntil - now) / 1000);
                        const remainMin = Math.ceil(remainSec / 60);
                        statusLabel += `[タイムアウト残:${remainMin}分] `;
                    }

                    const div = document.createElement('div');
                    div.className = "bg-white border border-black p-2 flex flex-col sm:flex-row items-start sm:items-center justify-between text-xs gap-2 text-black font-bold";

                    div.innerHTML = `
                        <div class="truncate w-full sm:w-auto pr-1">
                            <span class="font-bold text-black">ID: ${escapeHtml(idDisp)}</span> / 
                            <span>名前: <strong class="text-black">${escapeHtml(u.name || '')}</strong></span> 
                            <span class="text-black font-bold">${statusLabel}</span>
                        </div>
                        <div class="flex flex-wrap gap-1 w-full sm:w-auto justify-end shrink-0">
                            <button class="edit-idpass-btn px-2 py-0.5 border border-black bg-gray-100 text-black font-bold hover:bg-gray-200 cursor-pointer">ID/PW変</button>
                            <button class="rename-btn px-2 py-0.5 border border-black bg-gray-100 text-black font-bold hover:bg-gray-200 cursor-pointer">名前変</button>
                            <button class="retitle-btn px-2 py-0.5 border border-black bg-gray-100 text-black font-bold hover:bg-gray-200 cursor-pointer">肩書き変</button>
                            ${!isAdminUser ? `
                                <button class="timeout-btn px-2 py-0.5 border border-black font-bold bg-gray-100 text-black hover:opacity-80 cursor-pointer">${isTimedOut ? 'TO解除' : 'TO設定'}</button>
                                <button class="ban-btn px-2 py-0.5 border border-black font-bold bg-gray-100 text-black hover:opacity-80 cursor-pointer">${isBanned ? '解除' : 'BAN'}</button>
                                <button class="del-user-btn px-2 py-0.5 border border-black bg-gray-100 text-black font-bold hover:bg-gray-200 cursor-pointer">削除</button>
                            ` : ''}
                        </div>
                    `;

                    div.querySelector('.edit-idpass-btn').addEventListener('click', async () => {
                        const newId = prompt("新しいIDを入力:", id);
                        if (!newId || !newId.trim()) return;
                        const trimmedNewId = newId.trim();
                        const newPass = prompt("新しいパスワードを入力:", u.password);
                        if (!newPass || !newPass.trim()) return;
                        const trimmedNewPass = newPass.trim();

                        if (trimmedNewId !== id) {
                            const checkSnap = await get(ref(db, `id_registry/${trimmedNewId}`));
                            if (checkSnap.exists()) {
                                alert("そのIDはすでに使われています。");
                                return;
                            }
                            await set(ref(db, `id_registry/${trimmedNewId}`), { ...u, password: trimmedNewPass });
                            await remove(ref(db, `id_registry/${id}`));
                        } else {
                            await update(ref(db, `id_registry/${id}`), { password: trimmedNewPass });
                        }
                        showToast("IDとパスワードを更新しました");
                        loadAdminUsers();
                    });

                    div.querySelector('.rename-btn').addEventListener('click', async () => {
                        const newName = prompt(`「${u.name}」の新しい名前を入力:`, u.name);
                        if (!newName || !newName.trim()) return;
                        await update(ref(db, `id_registry/${id}`), { name: newName.trim() });
                        showToast("名前を更新しました");
                        loadAdminUsers();
                    });

                    div.querySelector('.retitle-btn').addEventListener('click', () => {
                        openCustomTitleModal(u.customTitle || "", async (selectedTitle) => {
                            await update(ref(db, `id_registry/${id}`), { customTitle: selectedTitle });
                            showToast("肩書きを更新しました");
                            loadAdminUsers();
                        });
                    });

                    if (!isAdminUser) {
                        div.querySelector('.timeout-btn').addEventListener('click', async () => {
                            if (isTimedOut) {
                                await update(ref(db, `id_registry/${id}`), { timeoutUntil: 0 });
                                showToast("タイムアウトを解除しました");
                                loadAdminUsers();
                            } else {
                                openTimeoutModal(async (targetTime) => {
                                    await update(ref(db, `id_registry/${id}`), { timeoutUntil: targetTime });
                                    showToast("タイムアウトを設定しました");
                                    loadAdminUsers();
                                });
                            }
                        });

                        div.querySelector('.ban-btn').addEventListener('click', async () => {
                            await update(ref(db, `id_registry/${id}`), { banned: !isBanned });
                            showToast("BAN状態を変更しました");
                            loadAdminUsers();
                        });

                        div.querySelector('.del-user-btn').addEventListener('click', async () => {
                            if (confirm(`ID: ${id} を削除しますか？`)) {
                                await remove(ref(db, `id_registry/${id}`));
                                showToast("ユーザーを削除しました");
                                loadAdminUsers();
                            }
                        });
                    }
                    fragment.appendChild(div);
                });

                if (filteredCount === 0) {
                    const emptyDiv = document.createElement('div');
                    emptyDiv.className = "text-black text-xs font-bold p-2";
                    emptyDiv.textContent = "該当するアカウントはありません。";
                    fragment.appendChild(emptyDiv);
                }

                adminUsersContainer.innerHTML = '';
                adminUsersContainer.appendChild(fragment);
            } catch (e) {}
        }

