                const isSelected = selectedShakeUsers.includes(id);
                const div = document.createElement('div');
                div.className = `px-2.5 py-1.5 cursor-pointer hover:bg-gray-200 text-xs truncate text-black font-bold flex justify-between items-center ${isSelected ? 'bg-gray-100 font-bold' : ''}`;
